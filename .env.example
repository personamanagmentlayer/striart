# ─────────────────────────────────────────────────────────────────────────────
# Striart — clés API des providers LLM (Router + fusion sémantique)
#
# Copiez ce fichier en `.env` (gitignoré) et renseignez UNIQUEMENT les clés
# du provider choisi dans striart.config (llm: { provider, model, baseUrl?,
# apiKeyEnv? }). Les clés ne vont JAMAIS dans striart.config — seulement ici
# ou dans les variables d'environnement du shell.
# ─────────────────────────────────────────────────────────────────────────────

# ══ ON-PREMISE / LOCAL — aucune clé requise ══════════════════════════════════

# Ollama (défaut de Striart — aucune config llm nécessaire) :
#   ollamaModel: 'llama3.1:8b', ollamaHost: 'http://localhost:11434'

# LM Studio :
#   llm: { provider: 'openai', model: 'mon-modele', baseUrl: 'http://localhost:1234/v1' }
# vLLM :
#   llm: { provider: 'openai', model: 'meta-llama/Llama-3.1-70B-Instruct', baseUrl: 'http://localhost:8000/v1' }
# llama.cpp (llama-server) :
#   llm: { provider: 'openai', model: 'default', baseUrl: 'http://localhost:8080/v1' }
# Text Generation Inference (HuggingFace TGI) :
#   llm: { provider: 'openai', model: 'tgi', baseUrl: 'http://localhost:8080/v1' }
# Si votre serveur local exige un token :
#   llm: { ..., apiKeyEnv: 'LOCAL_LLM_API_KEY' }
#LOCAL_LLM_API_KEY=

# ══ PROVIDERS CLOUD NATIFS ═══════════════════════════════════════════════════

# OpenAI — llm: { provider: 'openai', model: 'gpt-4o-mini' }
#OPENAI_API_KEY=

# Anthropic — llm: { provider: 'anthropic', model: 'claude-haiku-4-5-20251001' }
#ANTHROPIC_API_KEY=

# Azure OpenAI — model = nom du DEPLOYMENT, baseUrl = endpoint de la ressource :
#   llm: { provider: 'azure', model: 'mon-deploiement-gpt4o',
#          baseUrl: 'https://ma-ressource.openai.azure.com' }
#   (apiVersion: '2024-10-21' par défaut, surchargable via llm.apiVersion)
#AZURE_OPENAI_API_KEY=

# ══ CLOUD VIA ENDPOINT COMPATIBLE OPENAI ═════════════════════════════════════
# Tous utilisent llm: { provider: 'openai', model, baseUrl, apiKeyEnv } :

# Google Gemini — baseUrl: 'https://generativelanguage.googleapis.com/v1beta/openai',
#   model: 'gemini-2.0-flash', apiKeyEnv: 'GEMINI_API_KEY'
#GEMINI_API_KEY=

# Mistral — baseUrl: 'https://api.mistral.ai/v1', model: 'mistral-large-latest', apiKeyEnv: 'MISTRAL_API_KEY'
#MISTRAL_API_KEY=

# Groq — baseUrl: 'https://api.groq.com/openai/v1', model: 'llama-3.3-70b-versatile', apiKeyEnv: 'GROQ_API_KEY'
#GROQ_API_KEY=

# DeepSeek — baseUrl: 'https://api.deepseek.com/v1', model: 'deepseek-chat', apiKeyEnv: 'DEEPSEEK_API_KEY'
#DEEPSEEK_API_KEY=

# xAI Grok — baseUrl: 'https://api.x.ai/v1', model: 'grok-3-mini', apiKeyEnv: 'XAI_API_KEY'
#XAI_API_KEY=

# Together AI — baseUrl: 'https://api.together.xyz/v1', apiKeyEnv: 'TOGETHER_API_KEY'
#TOGETHER_API_KEY=

# Fireworks AI — baseUrl: 'https://api.fireworks.ai/inference/v1', apiKeyEnv: 'FIREWORKS_API_KEY'
#FIREWORKS_API_KEY=

# OpenRouter (agrégateur multi-modèles) — baseUrl: 'https://openrouter.ai/api/v1', apiKeyEnv: 'OPENROUTER_API_KEY'
#OPENROUTER_API_KEY=

# Perplexity — baseUrl: 'https://api.perplexity.ai', apiKeyEnv: 'PERPLEXITY_API_KEY'
#PERPLEXITY_API_KEY=

# Cohere (endpoint de compatibilité) — baseUrl: 'https://api.cohere.ai/compatibility/v1',
#   model: 'command-a-03-2025', apiKeyEnv: 'COHERE_API_KEY'
#COHERE_API_KEY=

# ══ AWS BEDROCK / GOOGLE VERTEX (auth SigV4 / OAuth) ═════════════════════════
# Auth non supportée en direct : passez par un proxy LiteLLM (openai-compatible)
#   litellm --model bedrock/anthropic.claude-3-5-sonnet --port 4000
#   llm: { provider: 'openai', model: 'bedrock/...', baseUrl: 'http://localhost:4000',
#          apiKeyEnv: 'LITELLM_API_KEY' }
#LITELLM_API_KEY=

# ══ NOTIFICATIONS (table `notifiers` de striart.config) ══════════════════════
# Une URL de webhook est un secret : préférez `urlEnv` à `url` en config.
#   notifiers: [{ type: 'slack',   urlEnv: 'SLACK_WEBHOOK_URL' },
#               { type: 'discord', urlEnv: 'DISCORD_WEBHOOK_URL' },
#               { type: 'generic', urlEnv: 'INTERNAL_WEBHOOK_URL' }]
#SLACK_WEBHOOK_URL=
#DISCORD_WEBHOOK_URL=
#INTERNAL_WEBHOOK_URL=
